{
  "name": "openslot",
  "version": "0.1.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "import": "node scripts/import-to-sanity.mjs",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy -c wrangler.jsonc",
    "covers": "node scripts/generate-covers.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "build:preview": "astro build --config astro.preview.config.mjs",
    "deploy:preview": "npm run build:preview && wrangler deploy -c dist-preview/server/wrangler.json && rm -rf .wrangler/deploy",
    "studio": "npm --prefix studio run dev",
    "deploy:studio": "npm --prefix studio run deploy"
  },
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/visual-editing": "^6.1.2",
    "astro": "^7.3.3",
    "astro-portabletext": "^1.0.1",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@portabletext/markdown": "^2.2.1",
    "js-yaml": "^5.4.2",
    "wrangler": "^4.135.0"
  }
}
