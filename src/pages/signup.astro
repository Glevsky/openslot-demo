---
import BaseLayout from "../layouts/BaseLayout.astro";
import Layout08 from "../components/sections/Layout08.astro";
import Layout17 from "../components/sections/Layout17.astro";
import Layout02 from "../components/sections/Layout02.astro";
---

<BaseLayout
  title="Start free"
  description="Create an Openslot workspace. The free plan needs no card, and the Team trial runs for 14 days."
>
  <Layout08
    eyebrow="Start free"
    heading="Your first booking page, in about five minutes"
    text="Connect a calendar, set the hours you work, and send the link. The free plan does not ask for a card and does not expire."
  />

  <Layout17 variant="signup" />

  <Layout02 label="In good company" />
</BaseLayout>
