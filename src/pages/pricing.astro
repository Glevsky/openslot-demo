---
import BaseLayout from "../layouts/BaseLayout.astro";
import Layout08 from "../components/sections/Layout08.astro";
import Layout10 from "../components/sections/Layout10.astro";
import Layout11 from "../components/sections/Layout11.astro";
import Layout02 from "../components/sections/Layout02.astro";
import Layout07 from "../components/sections/Layout07.astro";
import { getPricingPage, listFaq } from "../lib/content";

const page = await getPricingPage();
if (!page) throw new Error("The pricing page is missing from Sanity.");

const faq = await listFaq("pricing");
---

<BaseLayout title={page.title} description={page.summary}>
  <Layout08 eyebrow={page.eyebrow ?? undefined} heading={page.heading} text={page.text ?? undefined} align="center" />

  <Layout10 plans={page.plans} saving={page.saving ?? undefined} note={page.note ?? undefined} />

  <Layout02 label="Teams already on a paid plan" />

  <Layout11 heading={page.faqHeading ?? undefined} items={faq} />

  {
    page.closing && (
      <Layout07
        heading={page.closing.heading}
        text={page.closing.text ?? undefined}
        primary={page.closing.primary ?? undefined}
        secondary={page.closing.secondary ?? undefined}
        note={page.closing.note ?? undefined}
      />
    )
  }
</BaseLayout>
