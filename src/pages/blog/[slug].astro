---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Layout12 from "../../components/sections/Layout12.astro";
import Layout13 from "../../components/sections/Layout13.astro";
import Layout19 from "../../components/sections/Layout19.astro";
import Layout07 from "../../components/sections/Layout07.astro";
import {
  listPosts,
  getPost,
  relatedPosts,
  headings,
  formatDate,
  formatDateShort,
} from "../../lib/content";
import { coverUrl } from "../../lib/image";
import { blogHref } from "../../lib/taxonomy";

export const getStaticPaths: GetStaticPaths = async () => {
  const { listPosts: all } = await import("../../lib/content");
  return (await all()).map((post) => ({ params: { slug: post.slug } }));
};

const { slug } = Astro.params;
const post = await getPost(slug!);

if (!post) return Astro.rewrite("/404");

const posts = await listPosts();
const related = relatedPosts(posts, post);
const contents = headings(post.body);
const cover = coverUrl(post.cover, 1600);
const authorPhoto = coverUrl(post.author.avatar, 160);

const cards = related.map((item) => ({
  href: blogHref(item.slug),
  title: item.title,
  text: item.excerpt,
  cover: coverUrl(item.cover),
  pills: [item.category],
  meta: [formatDateShort(item.date), `${item.readTime} min`],
}));
---

<BaseLayout
  title={post.title}
  description={post.summary}
  ogType="article"
  preloadImage={cover}
>
  <Layout12
    backHref="/blog"
    backLabel="Back to the blog"
    kicker={post.category}
    title={post.title}
    author={{ ...post.author, photo: authorPhoto }}
    meta={[formatDate(post.date), `${post.readTime} min read`]}
    cover={cover}
  />

  <Layout13
    body={post.body}
    contents={contents}
    author={{ ...post.author, photo: coverUrl(post.author.avatar, 200) }}
  />

  {
    cards.length > 0 && (
      <Layout19
        heading="Keep reading"
        items={cards}
        link={{ label: "All posts", href: "/blog" }}
      />
    )
  }

  <Layout07 />
</BaseLayout>
