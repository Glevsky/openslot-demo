---
import BaseLayout from "../layouts/BaseLayout.astro";
import Layout08 from "../components/sections/Layout08.astro";
import Layout03 from "../components/sections/Layout03.astro";
import Layout05 from "../components/sections/Layout05.astro";
import Layout16 from "../components/sections/Layout16.astro";
import Layout07 from "../components/sections/Layout07.astro";
import { listAuthors } from "../lib/content";
import { coverUrl } from "../lib/image";

const people = (await listAuthors()).map((person) => ({
  name: person.name,
  role: person.role,
  bio: person.bio,
  photo: coverUrl(person.avatar, 640),
}));

const writers = people.filter((person) => person.bio);
const others = people.filter((person) => !person.bio);

const beliefs = [
  {
    icon: "target",
    title: "One job, done properly",
    text: "Openslot books meetings. It is not a CRM, a project tracker or a video tool, and we turn down the features that would make it one.",
  },
  {
    icon: "globe",
    title: "The invitee is the user too",
    text: "Half the people who touch Openslot never log in. The booking page has to work for them on a phone, on a bad connection, in their own time zone.",
  },
  {
    icon: "shield",
    title: "Boring beats clever",
    text: "Scheduling fails quietly and people find out at the wrong moment. We would rather ship the dull correct version than the interesting one.",
  },
  {
    icon: "users",
    title: "Small on purpose",
    text: "Twelve people across six countries. Everyone talks to customers, and the person who built a feature answers the tickets about it.",
  },
];

const stats = [
  { value: "2023", label: "founded in Lisbon" },
  { value: "12", label: "people across 6 countries" },
  { value: "38,000", label: "teams booking with us" },
  { value: "4.1M", label: "bookings in 2025" },
];
---

<BaseLayout
  title="About"
  description="Openslot was founded in Lisbon in 2023. Twelve people across six countries, building one thing: scheduling that holds up."
>
  <Layout08
    eyebrow="About"
    heading="We started this because a half hour took six emails to find"
    text="Openslot was founded in Lisbon in 2023 by Mara Lindqvist and Tomasz Wierzbicki, after one too many weeks spent arranging meetings instead of having them."
    primary={{ label: "See the product", href: "/product" }}
    secondary={{ label: "Talk to us", href: "/contact" }}
  />

  <Layout05 stats={stats} />

  <Layout03
    eyebrow="How we work"
    heading="Four things we keep coming back to"
    items={beliefs}
    columns={4}
    align="left"
  />

  <Layout16
    eyebrow="The team"
    heading="Who writes the software and answers the tickets"
    text="Everyone here talks to customers. The five people who write on the blog also build the thing they are writing about."
    people={writers}
    columns={3}
  />

  <Layout16
    heading="And the rest of us"
    people={others}
  />

  <Layout07
    heading="Come and break it"
    text="The free plan is the whole product for one person. If something does not hold up, we would genuinely like to hear about it."
    primary={{ label: "Start free", href: "/signup" }}
    secondary={{ label: "Tell us what broke", href: "/contact" }}
  />
</BaseLayout>
