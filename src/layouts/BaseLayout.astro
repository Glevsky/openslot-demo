---
import "../styles/main.css";
import Navbar from "../components/sections/Navbar.astro";
import Footer from "../components/sections/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  preloadImage?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  ogType = "website",
  preloadImage,
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === "Openslot" ? title : `${title} | Openslot`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Openslot" />
    <meta name="theme-color" content="#edf1e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-wrapper">
      <Navbar />
      <main class="main-wrapper" id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      .skip-link {
        position: absolute;
        top: var(--space-8);
        left: var(--space-8);
        z-index: 50;
        padding: var(--space-8) var(--space-16);
        color: var(--color-paper);
        background-color: var(--color-ink);
        border-radius: var(--radius-xsmall);
        font-size: var(--text-small-size);
        font-weight: var(--weight-semibold);
        transform: translateY(-200%);
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
