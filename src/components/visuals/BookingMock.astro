---
import Icon from "../ui/Icon.astro";
import Avatar from "../ui/Avatar.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const weekdays = ["M", "T", "W", "T", "F", "S", "S"];
const lead = 1;
const days = Array.from({ length: 30 }, (_, index) => index + 1);
const open = new Set([2, 3, 4, 8, 9, 10, 11, 15, 16, 17, 18, 22, 23, 24, 25, 29, 30]);
const selected = 16;

const slots = ["09:00", "09:30", "10:00", "11:30", "13:00", "14:30"];
const taken = "10:00";
---

<div class:list={["mock_component", className]} aria-hidden="true">
  <div class="mock_bar">
    <span class="mock_dots">
      <span class="mock_dot"></span>
      <span class="mock_dot"></span>
      <span class="mock_dot"></span>
    </span>
    <span class="mock_url">openslot.com/mara/intro-call</span>
  </div>

  <div class="mock_body">
    <div class="mock_event">
      <Avatar name="Mara Lindqvist" size="medium" />
      <p class="mock_host">Mara Lindqvist</p>
      <p class="mock_title">Intro call</p>

      <ul class="mock_facts" role="list">
        <li><Icon name="clock" size={16} /> 30 min</li>
        <li><Icon name="link" size={16} /> Video link added</li>
        <li><Icon name="globe" size={16} /> Central European Time</li>
      </ul>

      <p class="mock_note">
        Fifteen minutes to hear what you are working on, and fifteen to say
        whether we can help.
      </p>
    </div>

    <div class="mock_calendar">
      <div class="mock_month">
        <p class="mock_month-name">September 2026</p>
        <span class="mock_nav">
          <span class="mock_nav-button is-muted"><Icon name="caret" size={14} /></span>
          <span class="mock_nav-button"><Icon name="caret" size={14} /></span>
        </span>
      </div>

      <div class="mock_grid">
        {weekdays.map((day) => <span class="mock_weekday">{day}</span>)}
        {Array.from({ length: lead }, () => <span class="mock_day is-empty"></span>)}
        {
          days.map((day) => (
            <span
              class:list={[
                "mock_day",
                open.has(day) && "is-open",
                day === selected && "is-selected",
              ]}
            >
              {day}
            </span>
          ))
        }
      </div>
    </div>

    <div class="mock_slots">
      <p class="mock_slots-label">Wednesday 16</p>
      <ul class="mock_slot-list" role="list">
        {
          slots.map((slot) => (
            <li
              class:list={[
                "mock_slot",
                slot === taken && "is-taken",
                slot === "11:30" && "is-active",
              ]}
            >
              <span>{slot}</span>
              {slot === "11:30" && <span class="mock_slot-confirm">Confirm</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .mock_component {
    width: 100%;
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-raised);
    overflow: clip;
    user-select: none;
  }

  .mock_bar {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-16);
    background-color: var(--color-canvas);
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .mock_dots {
    display: flex;
    gap: var(--space-6);
  }

  .mock_dot {
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--color-line-strong);
    border-radius: var(--radius-pill);
  }

  .mock_url {
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1;
  }

  .mock_body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 0.65fr);
  }

  .mock_event {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    padding: var(--space-24);
    border-right: var(--border-width) solid var(--color-line);
  }

  .mock_host {
    margin-top: var(--space-4);
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.4;
  }

  .mock_title {
    font-family: var(--font-heading);
    font-size: var(--heading-medium-size);
    line-height: 1.2;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--heading-medium-tracking);
  }

  .mock_facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .mock_facts li {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-xsmall-size);
    line-height: 1.3;
  }

  .mock_note {
    margin-top: auto;
    padding-top: var(--space-16);
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.53846;
  }

  .mock_calendar {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-24);
    border-right: var(--border-width) solid var(--color-line);
  }

  .mock_month {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mock_month-name {
    font-family: var(--font-heading);
    font-size: var(--text-small-size);
    line-height: 1;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }

  .mock_nav {
    display: flex;
    gap: var(--space-4);
  }

  .mock_nav-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-ink-muted);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-xsmall);
  }

  .mock_nav-button:first-child {
    transform: rotate(90deg);
  }

  .mock_nav-button:last-child {
    transform: rotate(-90deg);
  }

  .mock_nav-button.is-muted {
    color: var(--color-line-strong);
  }

  .mock_grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .mock_weekday {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: var(--space-4);
    color: var(--color-ink-subtle);
    font-size: 0.6875rem;
    line-height: 1;
    font-weight: var(--weight-semibold);
  }

  .mock_day {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    color: var(--color-ink-subtle);
    font-size: 0.75rem;
    line-height: 1;
    border-radius: var(--radius-xsmall);
  }

  .mock_day.is-empty {
    visibility: hidden;
  }

  .mock_day.is-open {
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
    font-weight: var(--weight-semibold);
  }

  .mock_day.is-selected {
    color: var(--color-paper);
    background-color: var(--color-accent);
  }

  .mock_slots {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-24) var(--space-20);
    background-color: var(--color-canvas);
  }

  .mock_slots-label {
    color: var(--color-ink-subtle);
    font-size: 0.6875rem;
    line-height: 1;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
  }

  .mock_slot-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mock_slot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line-strong);
    border-radius: var(--radius-xsmall);
    font-size: var(--text-xsmall-size);
    line-height: 1;
    font-weight: var(--weight-medium);
  }

  .mock_slot.is-taken {
    color: var(--color-ink-subtle);
    background-color: transparent;
    border-style: dashed;
    text-decoration: line-through;
  }

  .mock_slot.is-active {
    gap: var(--space-2);
    padding: 0;
    overflow: clip;
    border-color: var(--color-accent);
  }

  .mock_slot.is-active > span:first-child {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    height: 100%;
  }

  .mock_slot-confirm {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    height: 100%;
    color: var(--color-paper);
    background-color: var(--color-accent);
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 991px) {
    .mock_body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
    }

    .mock_event {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: var(--border-width) solid var(--color-line);
    }

    .mock_note {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .mock_body {
      grid-template-columns: minmax(0, 1fr);
    }

    .mock_calendar {
      border-right: 0;
      border-bottom: var(--border-width) solid var(--color-line);
    }

    .mock_slot-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
