---
interface Props {
  name: string;
  value?: string;
  label: string;
  required?: boolean;
  class?: string;
}

const { name, value = "yes", label, required = false, class: className } =
  Astro.props;
---

<label class:list={["checkbox_component", className]}>
  <input
    class="checkbox_input"
    type="checkbox"
    name={name}
    value={value}
    required={required}
  />

  <span class="checkbox_box" aria-hidden="true">
    <svg viewBox="0 0 12 12" width="12" height="12" fill="none">
      <path
        d="m2.5 6.25 2.25 2.25L9.5 3.75"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  <span class="checkbox_label">{label}</span>
</label>

<style>
  .checkbox_component {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    cursor: pointer;
  }

  .checkbox_input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .checkbox_box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.1875rem;
    color: var(--color-paper);
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line-strong);
    border-radius: 0.3125rem;
    transition: var(--transition-interactive);
  }

  .checkbox_box svg {
    opacity: 0;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }

  @media (hover: hover) {
    .checkbox_component:hover .checkbox_box {
      border-color: var(--color-ink-subtle);
    }
  }

  .checkbox_input:checked ~ .checkbox_box {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .checkbox_input:checked ~ .checkbox_box svg {
    opacity: 1;
  }

  .checkbox_input:focus-visible ~ .checkbox_box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .checkbox_input:user-invalid ~ .checkbox_box {
    border-color: var(--color-error);
  }

  .checkbox_label {
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
  }
</style>
