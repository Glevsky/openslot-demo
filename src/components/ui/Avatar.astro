---
interface Props {
  name: string;
  src?: string;
  size?: "small" | "medium" | "large" | "xlarge";
  class?: string;
}

const { name, src, size = "small", class: className } = Astro.props;

const initials = name
  .split(" ")
  .filter((part) => /[A-Za-zÀ-ÿ]/.test(part[0] ?? ""))
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("");

const tones = ["a", "b", "c", "d", "e"];
const sum = [...name].reduce((total, char) => total + char.charCodeAt(0), 0);
const tone = tones[sum % tones.length];
---

{
  src ? (
    <img
      class:list={["avatar_component", "is-photo", `is-${size}`, className]}
      src={src}
      alt=""
      width="640"
      height="640"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      class:list={["avatar_component", `is-${size}`, `is-tone-${tone}`, className]}
      aria-hidden="true"
    >
      {initials}
    </span>
  )
}

<style>
  .avatar_component {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    line-height: 1;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    border-radius: var(--radius-pill);
  }

  .avatar_component.is-medium {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 0.9375rem;
  }

  .avatar_component.is-large {
    width: 4rem;
    height: 4rem;
    font-size: 1.25rem;
  }

  .avatar_component.is-xlarge {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-medium);
  }

  .avatar_component.is-photo {
    object-fit: cover;
    background-color: var(--color-surface);
  }

  .avatar_component.is-tone-a {
    color: #3a5020;
    background-color: #e7eeda;
  }

  .avatar_component.is-tone-b {
    color: #2c5b4a;
    background-color: #dfeae5;
  }

  .avatar_component.is-tone-c {
    color: #2f5d3f;
    background-color: #e3ece3;
  }

  .avatar_component.is-tone-d {
    color: #44543f;
    background-color: #e6ebdf;
  }

  .avatar_component.is-tone-e {
    color: #2a5f56;
    background-color: #ddeae7;
  }
</style>
