---
interface Props {
  tone?: "ink" | "paper";
  href?: string;
  class?: string;
}

const { tone = "ink", href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class:list={["logo_component", `is-${tone}`, className]}
  href={href}
  aria-label={href ? "Openslot, home" : undefined}
>
  <svg
    class="logo_mark"
    viewBox="0 0 28 28"
    width="28"
    height="28"
    fill="none"
    aria-hidden="true"
  >
    <rect
      x="1"
      y="1"
      width="26"
      height="26"
      rx="8"
      stroke="currentColor"
      stroke-width="2"
    />
    <rect x="6.5" y="9" width="15" height="3.5" rx="1.75" fill="currentColor" />
    <rect
      x="6.5"
      y="16"
      width="8"
      height="3.5"
      rx="1.75"
      fill="var(--logo-slot-color, #d9531e)"
    />
  </svg>
  <span class="logo_word">Openslot</span>
</Tag>

<style>
  .logo_component {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    line-height: 1;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.028em;
    transition: var(--transition-interactive);
  }

  .logo_component.is-ink {
    color: var(--color-ink);
  }

  .logo_component.is-paper {
    color: var(--color-paper);
  }

  .logo_mark {
    flex-shrink: 0;
  }

  .logo_word {
    padding-top: 0.0625rem;
  }
</style>
