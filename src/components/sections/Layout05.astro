---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  heading?: string;
  stats: Stat[];
  tone?: "plain" | "dark";
}

const { heading, stats, tone = "plain" } = Astro.props;
---

<section class:list={["section_layout05", `is-${tone}`]}>
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="layout05_component">
        {heading && <h2 class="heading-mlarge layout05_heading">{heading}</h2>}

        <dl class="layout05_list">
          {
            stats.map((stat) => (
              <div class="layout05_item">
                <dt class="layout05_value">{stat.value}</dt>
                <dd class="layout05_label">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .section_layout05.is-dark {
    color: var(--color-paper);
    background-color: var(--color-dark);
  }

  .section_layout05.is-plain {
    background-color: var(--color-paper);
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout05_component {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: var(--space-64);
    align-items: center;
  }

  .layout05_component:not(:has(.layout05_heading)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .layout05_heading {
    max-width: 20rem;
    text-wrap: balance;
  }

  .layout05_list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-32);
  }

  .layout05_item {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section_layout05.is-plain .layout05_item {
    padding-left: var(--space-20);
    border-left: var(--border-width) solid var(--color-line);
  }

  .layout05_value {
    font-family: var(--font-heading);
    font-size: var(--heading-large-size);
    line-height: 1.1;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--heading-large-tracking);
  }

  .layout05_label {
    margin: 0;
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    text-wrap: pretty;
  }

  .section_layout05.is-dark .layout05_label {
    color: var(--color-paper-60);
  }

  .section_layout05.is-plain .layout05_label {
    color: var(--color-ink-muted);
  }

  @media (max-width: 991px) {
    .layout05_component {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-40);
    }
  }

  @media (max-width: 767px) {
    .layout05_list {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-32) var(--space-16);
    }
  }
</style>
