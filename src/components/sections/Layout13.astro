---
import Prose from "../ui/Prose.astro";
import Avatar from "../ui/Avatar.astro";

interface Props {
  body: unknown;
  contents?: { id: string; text: string }[];
  author?: { name: string; role: string; bio?: string };
}

const { body, contents = [], author } = Astro.props;
---

<section class="section_layout13">
  <div class="padding-global padding-section-medium">
    <div class="container-large layout13_component">
      {
        contents.length > 1 && (
          <nav class="layout13_index" aria-label="On this page">
            <p class="layout13_index-label text-label">On this page</p>
            <ul class="layout13_index-list" role="list">
              {contents.map((item) => (
                <li>
                  <a class="layout13_index-link" href={`#${item.id}`}>
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="layout13_body">
        <Prose value={body} />

        {
          author?.bio && (
            <aside class="layout13_author">
              <Avatar name={author.name} size="medium" />
              <div class="layout13_author-body">
                <p class="layout13_author-name">{author.name}</p>
                <p class="layout13_author-role">{author.role}</p>
                <p class="layout13_author-bio">{author.bio}</p>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .layout13_component {
    display: grid;
    grid-template-columns: 15rem minmax(0, 44rem);
    justify-content: center;
    column-gap: var(--space-64);
    align-items: start;
  }

  .layout13_component:not(:has(.layout13_index)) {
    grid-template-columns: minmax(0, 44rem);
  }

  .layout13_index {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .layout13_index-label {
    color: var(--color-ink-subtle);
  }

  .layout13_index-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-left: var(--border-width) solid var(--color-line);
  }

  .layout13_index-link {
    display: block;
    padding: var(--space-6) var(--space-12);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--color-ink-subtle);
    font-size: var(--text-small-size);
    line-height: 1.42857;
    text-wrap: pretty;
  }

  .layout13_index-link:hover,
  .layout13_index-link:focus-visible {
    color: var(--color-ink);
  }

  .layout13_index-link.is-active {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
    border-left-color: var(--color-accent);
  }

  .layout13_body {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    min-width: 0;
  }

  .layout13_author {
    display: flex;
    gap: var(--space-16);
    padding: var(--space-24);
    background-color: var(--color-canvas);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-medium);
  }

  .layout13_author-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .layout13_author-name {
    font-family: var(--font-heading);
    font-size: var(--heading-xsmall-size);
    line-height: 1.3;
    font-weight: var(--weight-semibold);
  }

  .layout13_author-role {
    color: var(--color-accent);
    font-size: var(--text-xsmall-size);
    line-height: 1.4;
  }

  .layout13_author-bio {
    margin-top: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    text-wrap: pretty;
  }

  @media (max-width: 991px) {
    .layout13_component {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-32);
    }

    .layout13_component:not(:has(.layout13_index)) {
      grid-template-columns: minmax(0, 1fr);
    }

    .layout13_index {
      position: static;
      padding: var(--space-20);
      background-color: var(--color-canvas);
      border-radius: var(--radius-medium);
    }
  }
</style>

<script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(".layout13_index-link"),
  ];

  if (links.length) {
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((target): target is HTMLElement => Boolean(target));

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (!visible[0]) return;
        for (const link of links) {
          link.classList.toggle(
            "is-active",
            decodeURIComponent(link.hash.slice(1)) === visible[0].target.id
          );
        }
      },
      { rootMargin: "-88px 0px -70% 0px" }
    );

    for (const target of targets) observer.observe(target);
  }
</script>
