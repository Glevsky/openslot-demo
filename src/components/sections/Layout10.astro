---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Pill from "../ui/Pill.astro";

const plans = [
  {
    name: "Free",
    yearly: "$0",
    monthly: "$0",
    unit: "forever",
    text: "One booking page, for one person who just needs a link.",
    cta: { label: "Start free", href: "/signup" },
    variant: "secondary" as const,
    features: [
      "1 booking page",
      "1 calendar connected",
      "Email reminders",
      "Time-zone detection",
      "Openslot branding on the page",
    ],
  },
  {
    name: "Pro",
    yearly: "$12",
    monthly: "$15",
    unit: "per user, per month",
    text: "For one person or a small team who books all day.",
    cta: { label: "Start the trial", href: "/signup" },
    variant: "primary" as const,
    featured: true,
    features: [
      "Unlimited booking pages",
      "SMS reminders",
      "Workflows and webhooks",
      "Inline and popup embeds",
      "No Openslot branding",
    ],
  },
  {
    name: "Team",
    yearly: "$20",
    monthly: "$24",
    unit: "per user, per month",
    text: "For teams where a booking has to reach the right person.",
    cta: { label: "Start the trial", href: "/signup" },
    variant: "secondary" as const,
    features: [
      "Everything in Pro",
      "Round-robin team pages",
      "Collective team pages",
      "Routing forms and meeting polls",
      "Admin controls and priority support",
    ],
  },
  {
    name: "Enterprise",
    yearly: "Custom",
    monthly: "Custom",
    unit: "talk to us",
    text: "For organizations with procurement and a security review.",
    cta: { label: "Contact us", href: "/contact" },
    variant: "secondary" as const,
    features: [
      "Everything in Team",
      "Single sign-on",
      "Audit log",
      "Data residency",
      "Dedicated support contact",
    ],
  },
];
---

<section class="section_layout10">
  <div class="padding-global padding-section-large padding-top-none">
    <div class="container-large">
      <div class="layout10_component">
        <div class="layout10_toggle">
          <input
            class="layout10_switch"
            type="checkbox"
            id="billing-yearly"
            checked
          />
          <label class="layout10_switch-label" for="billing-yearly">
            <span class="layout10_switch-track" aria-hidden="true">
              <span class="layout10_switch-knob"></span>
            </span>
            Bill yearly
          </label>
          <Pill tone="accent">Save 20 percent</Pill>
        </div>

        <ul class="layout10_list" role="list">
          {
            plans.map((plan) => (
              <li class:list={["layout10_plan", plan.featured && "is-featured"]}>
                <div class="layout10_head">
                  <p class="layout10_name">{plan.name}</p>
                  {plan.featured && <Pill tone="dark">Most popular</Pill>}
                </div>

                <p class="layout10_price">
                  <span class="layout10_amount is-yearly">{plan.yearly}</span>
                  <span class="layout10_amount is-monthly">{plan.monthly}</span>
                  <span class="layout10_unit">{plan.unit}</span>
                </p>

                <p class="layout10_text">{plan.text}</p>

                <Button href={plan.cta.href} variant={plan.variant} full>
                  {plan.cta.label}
                </Button>

                <ul class="layout10_features" role="list">
                  {plan.features.map((feature) => (
                    <li>
                      <Icon name="check" size={16} />
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <p class="layout10_note">
          Prices are per user, per month, and exclude tax. The Team trial runs
          for 14 days and does not ask for a card.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .layout10_component {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .layout10_toggle {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .layout10_switch {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .layout10_switch-label {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--text-small-size);
    line-height: 1.3;
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .layout10_switch-track {
    display: flex;
    align-items: center;
    width: 2.375rem;
    height: 1.375rem;
    padding: 0.1875rem;
    background-color: var(--color-line-strong);
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-duration) var(--transition-easing);
  }

  .layout10_switch-knob {
    width: 1rem;
    height: 1rem;
    background-color: var(--color-paper);
    border-radius: var(--radius-pill);
    transition: translate var(--transition-duration) var(--transition-easing);
  }

  .layout10_switch:checked + .layout10_switch-label .layout10_switch-track {
    background-color: var(--color-accent);
  }

  .layout10_switch:checked + .layout10_switch-label .layout10_switch-knob {
    translate: 1rem 0;
  }

  .layout10_switch:focus-visible + .layout10_switch-label .layout10_switch-track {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .layout10_amount.is-monthly {
    display: none;
  }

  .layout10_component:has(.layout10_switch:not(:checked)) .layout10_amount.is-yearly {
    display: none;
  }

  .layout10_component:has(.layout10_switch:not(:checked)) .layout10_amount.is-monthly {
    display: block;
  }

  .layout10_list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .layout10_plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-24);
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-medium);
  }

  .layout10_plan.is-featured {
    border-color: var(--color-ink);
    box-shadow: var(--shadow-card);
  }

  .layout10_head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 1.75rem;
  }

  .layout10_name {
    font-family: var(--font-heading);
    font-size: var(--heading-small-size);
    line-height: 1.2;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--heading-small-tracking);
  }

  .layout10_price {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .layout10_amount {
    font-family: var(--font-heading);
    font-size: 2.125rem;
    text-wrap: nowrap;
    line-height: 1.11765;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.028em;
  }

  .layout10_unit {
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.38462;
  }

  .layout10_text {
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    text-wrap: pretty;
  }

  .layout10_features {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-8);
    margin-top: auto;
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout10_features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-xsmall-size);
    line-height: 1.53846;
  }

  .layout10_features :global(.icon_component) {
    margin-top: 0.1875rem;
    color: var(--color-positive);
  }

  .layout10_note {
    color: var(--color-ink-subtle);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
  }

  @media (max-width: 991px) {
    .layout10_list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .layout10_list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
