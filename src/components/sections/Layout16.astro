---
import Avatar from "../ui/Avatar.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import SectionIntro from "../ui/SectionIntro.astro";

interface Person {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  text?: string;
  people: Person[];
  columns?: 3 | 4;
  tone?: "paper" | "canvas";
}

const { eyebrow, heading, text, people, columns = 4, tone = "paper" } = Astro.props;
---

<section class:list={["section_layout16", `is-${tone}`]}>
  <div class="padding-global padding-section-large">
    <div class="container-large">
      <div class="layout16_component">
        <SectionIntro width="600px">
          {eyebrow && <Eyebrow slot="eyebrow">{eyebrow}</Eyebrow>}
          <h2>{heading}</h2>
          {text && <p class="text-large text-color-muted">{text}</p>}
        </SectionIntro>

        <ul class:list={["layout16_list", `is-${columns}column`]} role="list">
          {
            people.map((person) => (
              <li class="layout16_item">
                <Avatar name={person.name} src={person.photo} size="xlarge" />
                <p class="layout16_name">{person.name}</p>
                <p class="layout16_role">{person.role}</p>
                {person.bio && <p class="layout16_bio">{person.bio}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section_layout16.is-canvas {
    background-color: var(--color-paper);
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout16_component {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
  }

  .layout16_list {
    display: grid;
    gap: var(--space-40) var(--space-24);
  }

  .layout16_list.is-4column {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .layout16_list.is-3column {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .layout16_item {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
  }

  .layout16_name {
    margin-top: var(--space-16);
    font-family: var(--font-heading);
    font-size: var(--heading-xsmall-size);
    line-height: 1.3;
    font-weight: var(--weight-semibold);
  }

  .layout16_role {
    color: var(--color-accent);
    font-size: var(--text-xsmall-size);
    line-height: 1.4;
  }

  .layout16_bio {
    margin-top: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    text-wrap: pretty;
  }

  @media (max-width: 991px) {
    .layout16_list.is-4column,
    .layout16_list.is-3column {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .layout16_list.is-4column,
    .layout16_list.is-3column {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-32) var(--space-16);
    }
  }
</style>
