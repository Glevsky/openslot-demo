---
import Icon from "../ui/Icon.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";

interface Props {
  eyebrow: string;
  heading: string;
  text: string;
  points?: string[];
  link?: { label: string; href: string };
  reverse?: boolean;
  tone?: "paper" | "canvas";
  id?: string;
}

const {
  eyebrow,
  heading,
  text,
  points = [],
  link,
  reverse = false,
  tone = "paper",
  id,
} = Astro.props;
---

<section class:list={["section_layout04", `is-${tone}`]} id={id}>
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class:list={["layout-columns layout04_component", reverse && "is-reverse"]}>
        <div class="layout04_copy">
          <Eyebrow>{eyebrow}</Eyebrow>
          <h2>{heading}</h2>
          <p class="text-large text-color-muted text-pretty">{text}</p>

          {
            points.length > 0 && (
              <ul class="layout04_points" role="list">
                {points.map((point) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )
          }

          {
            link && (
              <Button href={link.href} variant="secondary" arrow class="layout04_link">
                {link.label}
              </Button>
            )
          }
        </div>

        <div class="layout04_visual">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section_layout04.is-canvas {
    background-color: var(--color-canvas);
    border-block: var(--border-width) solid var(--color-line);
  }

  .layout04_copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .layout04_points {
    display: flex;
    flex-direction: column;
    gap: var(--space-10, 0.625rem);
    margin-top: var(--space-4);
  }

  .layout04_points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
  }

  .layout04_points :global(.icon_component) {
    margin-top: 0.1875rem;
    color: var(--color-positive);
  }

  .layout04_link {
    margin-top: var(--space-8);
  }

  .layout04_visual {
    min-width: 0;
  }
</style>
