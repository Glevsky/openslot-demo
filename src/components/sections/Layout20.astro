---
import Pill from "../ui/Pill.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  href: string;
  title: string;
  text: string;
  type: string;
  meta: string;
  cta: string;
  cover?: string;
  highlights?: string[];
}

const { href, title, text, type, meta, cta, cover, highlights = [] } = Astro.props;
---

<section class="section_layout20">
  <div class="padding-global padding-section-medium padding-bottom-none">
    <div class="container-large">
      <article class="layout20_component">
        <div class="layout20_body">
          <div class="layout20_tags">
            <Pill tone="accent">Featured</Pill>
            <Pill tone="outline">{type}</Pill>
          </div>

          <h2 class="heading-mlarge">{title}</h2>
          <p class="text-large text-color-muted text-pretty">{text}</p>

          {
            highlights.length > 0 && (
              <ul class="layout20_points" role="list">
                {highlights.slice(0, 3).map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="layout20_foot">
            <Button href={href} variant="primary" arrow>{cta}</Button>
            <span class="layout20_meta">{meta}</span>
          </div>
        </div>

        {
          cover && (
            <img
              class="layout20_cover"
              src={cover}
              alt=""
              width="800"
              height="500"
              loading="eager"
              decoding="async"
            />
          )
        }
      </article>
    </div>
  </div>
</section>

<style>
  .layout20_component {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--space-48);
    align-items: center;
    padding: var(--space-40);
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-large);
  }

  .layout20_body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .layout20_tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .layout20_points {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout20_points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: 1.5;
  }

  .layout20_points :global(.icon_component) {
    margin-top: 0.1875rem;
    color: var(--color-positive);
  }

  .layout20_foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    margin-top: var(--space-8);
  }

  .layout20_meta {
    color: var(--color-ink-subtle);
    font-size: var(--text-small-size);
  }

  .layout20_cover {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-medium);
  }

  @media (max-width: 991px) {
    .layout20_component {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
      padding: var(--space-24);
    }

    .layout20_cover {
      order: -1;
      height: 12rem;
    }
  }
</style>
