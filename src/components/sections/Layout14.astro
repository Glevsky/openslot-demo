---
import Field from "../ui/Field.astro";
import Checkbox from "../ui/Checkbox.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Pill from "../ui/Pill.astro";
import Prose from "../ui/Prose.astro";
import Avatar from "../ui/Avatar.astro";

interface Props {
  resource: {
    title: string;
    type: string;
    topics: string[];
    level: string;
    meta: string;
    cta: string;
    gated: boolean;
    highlights: string[];
    cover?: string;
    duration?: string;
    status?: string;
    speakers?: { name: string; role: string }[];
    lessons?: { title: string; length: string }[];
    author: { name: string; role: string };
    body?: unknown;
  };
}

const { resource } = Astro.props;
const formId = `resource-${resource.type.toLowerCase()}`;
---

<section class="section_layout14">
  <div class="padding-global padding-section-medium">
    <div class="container-large layout14_component">
      <div class="layout14_main">
        {resource.body && <Prose value={resource.body} />}

        {
          resource.lessons && resource.lessons.length > 0 && (
            <ol class="layout14_lessons" role="list">
              {resource.lessons.map((lesson, index) => (
                <li class="layout14_lesson">
                  <span class="layout14_lesson-index">{index + 1}</span>
                  <span class="layout14_lesson-title">{lesson.title}</span>
                  <span class="layout14_lesson-length">{lesson.length}</span>
                </li>
              ))}
            </ol>
          )
        }

      </div>

      <aside class="layout14_aside">
        <div class="layout14_card">
          {
            resource.cover && (
              <img
                class="layout14_cover"
                src={resource.cover}
                alt=""
                width="800"
                height="500"
                loading="eager"
                decoding="async"
              />
            )
          }

          <div class="layout14_card-body">
            <div class="layout14_tags">
              <Pill tone="accent">{resource.type}</Pill>
              <Pill tone="outline">{resource.level}</Pill>
            </div>

            <ul class="layout14_facts" role="list">
              <li><Icon name="book" size={16} /> {resource.meta}</li>
              {resource.duration && resource.duration !== resource.meta && (
                <li><Icon name="clock" size={16} /> {resource.duration}</li>
              )}
              {resource.status && (
                <li><Icon name="calendar" size={16} /> {resource.status}</li>
              )}
              <li><Icon name="users" size={16} /> By {resource.author.name}</li>
            </ul>

            {
              resource.gated ? (
                <form class="layout14_form" id={formId} novalidate>
                  <p class="layout14_form-title">{resource.cta}</p>
                  <Field name={`${formId}-name`} label="Full name" required autocomplete="name" placeholder="Your name" />
                  <Field name={`${formId}-email`} label="Work email" type="email" required autocomplete="email" placeholder="you@company.com" />
                  <Field name={`${formId}-company`} label="Company" placeholder="Where you work" />
                  <Checkbox
                    name={`${formId}-consent`}
                    label="Send me an occasional email about scheduling. No more than once a month."
                  />
                  <Button type="submit" variant="primary" full>{resource.cta}</Button>
                  <p class="layout14_fineprint">
                    This is a demo form. Nothing is sent and nothing is stored.
                  </p>
                </form>
              ) : (
                <div class="layout14_open">
                  <Button href="/signup" variant="primary" full arrow>{resource.cta}</Button>
                  <p class="layout14_fineprint">Free, and there is no form.</p>
                </div>
              )
            }
          </div>
        </div>

        <div class="layout14_highlights">
          <p class="layout14_highlights-label text-label">What you get</p>
          <ul role="list">
            {
              resource.highlights.map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          resource.speakers && resource.speakers.length > 0 && (
            <div class="layout14_speakers">
              <p class="layout14_highlights-label text-label">Presented by</p>
              <ul class="layout14_speaker-list" role="list">
                {resource.speakers.map((speaker) => (
                  <li class="layout14_speaker">
                    <Avatar name={speaker.name} />
                    <span class="layout14_speaker-body">
                      <span class="layout14_speaker-name">{speaker.name}</span>
                      <span class="layout14_speaker-role">{speaker.role}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="layout14_topics">
          <p class="layout14_highlights-label text-label">Topics</p>
          <div class="layout14_tags">
            {resource.topics.map((topic) => <Pill tone="neutral">{topic}</Pill>)}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .layout14_component {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: var(--space-64);
    align-items: start;
  }

  .layout14_main {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
    max-width: 42rem;
  }

  .layout14_lessons {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout14_lesson {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-16);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-small);
  }

  .layout14_lesson-index {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-pill);
    font-size: var(--text-xsmall-size);
    font-weight: var(--weight-semibold);
  }

  .layout14_lesson-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--text-small-size);
    line-height: 1.4;
    font-weight: var(--weight-medium);
  }

  .layout14_lesson-length {
    flex-shrink: 0;
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
  }

  .layout14_speakers {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .layout14_speaker-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout14_speaker {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .layout14_speaker-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .layout14_speaker-name {
    font-size: var(--text-small-size);
    line-height: 1.35;
    font-weight: var(--weight-semibold);
  }

  .layout14_speaker-role {
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .layout14_aside {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .layout14_card {
    background-color: var(--color-paper);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-card);
    overflow: clip;
  }

  .layout14_cover {
    width: 100%;
    height: 9rem;
    object-fit: cover;
    background-color: var(--color-surface);
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .layout14_card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-20);
  }

  .layout14_tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .layout14_facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout14_facts li {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: 1.35;
  }

  .layout14_facts :global(.icon_component) {
    color: var(--color-ink-subtle);
  }

  .layout14_form {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout14_form-title {
    font-family: var(--font-heading);
    font-size: var(--heading-xsmall-size);
    line-height: 1.3;
    font-weight: var(--weight-semibold);
  }

  .layout14_open {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout14_fineprint {
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.46154;
    text-align: center;
  }

  .layout14_highlights,
  .layout14_topics {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .layout14_highlights-label {
    color: var(--color-ink-subtle);
  }

  .layout14_highlights ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout14_highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: 1.5;
  }

  .layout14_highlights :global(.icon_component) {
    margin-top: 0.1875rem;
    color: var(--color-positive);
  }

  @media (max-width: 991px) {
    .layout14_component {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-48);
    }

    .layout14_aside {
      position: static;
      max-width: 26rem;
    }
  }


</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(".layout14_form")) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        for (const field of form.querySelectorAll<HTMLElement>(".field_component")) {
          const input = field.querySelector<HTMLInputElement>(".field_input");
          field.classList.toggle("is-invalid", Boolean(input && !input.checkValidity()));
        }
        return;
      }

      const done = document.createElement("div");
      done.className = "layout14_done";
      done.innerHTML =
        "<p class='layout14_done-title'>Thanks, that would normally be on its way.</p>" +
        "<p class='layout14_fineprint'>This is a demo, so nothing was sent or stored.</p>";
      form.replaceWith(done);
    });
  }
</script>

<style is:global>
  .layout14_done {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-16);
    border-top: var(--border-width) solid var(--color-line);
  }

  .layout14_done-title {
    font-family: var(--font-heading);
    font-size: var(--heading-xsmall-size);
    line-height: 1.35;
    font-weight: var(--weight-semibold);
    color: var(--color-positive);
  }
</style>
