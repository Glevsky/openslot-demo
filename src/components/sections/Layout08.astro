---
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  size?: "large" | "medium";
  align?: "left" | "center";
}

const {
  eyebrow,
  heading,
  text,
  primary,
  secondary,
  size = "large",
  align = "left",
} = Astro.props;
---

<section class="section_layout08">
  <div class="padding-global layout08_padding">
    <div class:list={["container-large layout08_component", `is-${align}`]}>
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 class:list={[size === "large" ? "heading-xlarge" : "heading-large"]}>
        {heading}
      </h1>
      {text && <p class="text-xlarge text-color-muted layout08_text">{text}</p>}

      {
        (primary || secondary) && (
          <div class="button-group layout08_actions">
            {primary && (
              <Button href={primary.href} variant="primary" size="large" arrow>
                {primary.label}
              </Button>
            )}
            {secondary && (
              <Button href={secondary.href} variant="secondary" size="large">
                {secondary.label}
              </Button>
            )}
          </div>
        )
      }

      <slot />
    </div>
  </div>
</section>

<style>
  .section_layout08 {
    background-color: var(--color-paper);
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .layout08_padding {
    padding-top: var(--space-80);
    padding-bottom: var(--space-80);
  }

  .layout08_component {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-20);
  }

  .layout08_component.is-center {
    align-items: center;
    text-align: center;
  }

  .layout08_component :global(h1) {
    max-width: 44rem;
  }

  .layout08_text {
    max-width: 38rem;
    text-wrap: pretty;
  }

  .layout08_actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 991px) {
    .layout08_padding {
      padding-top: var(--space-56);
      padding-bottom: var(--space-56);
    }
  }

  @media (max-width: 767px) {
    .layout08_padding {
      padding-top: var(--space-40);
      padding-bottom: var(--space-40);
    }
  }
</style>
