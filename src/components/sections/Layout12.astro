---
import Pill from "../ui/Pill.astro";
import Avatar from "../ui/Avatar.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  backHref: string;
  backLabel: string;
  kicker: string;
  title: string;
  author?: { name: string; role: string };
  meta: string[];
  cover?: string;
}

const { backHref, backLabel, kicker, title, author, meta, cover } = Astro.props;
---

<section class="section_layout12">
  <div class="padding-global layout12_padding">
    <div class="container-medium layout12_component">
      <a class="layout12_back" href={backHref}>
        <Icon name="arrow-left" size={16} />
        {backLabel}
      </a>

      <Pill tone="accent">{kicker}</Pill>

      <h1 class="heading-xlarge">{title}</h1>

      <div class="layout12_meta">
        {
          author && (
            <span class="layout12_author">
              <Avatar name={author.name} />
              <span class="layout12_author-body">
                <span class="layout12_author-name">{author.name}</span>
                <span class="layout12_author-role">{author.role}</span>
              </span>
            </span>
          )
        }

        <p class="layout12_facts">
          {
            meta.map((entry, index) => (
              <>
                {index > 0 && <span class="layout12_dot" aria-hidden="true" />}
                <span>{entry}</span>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </div>

  {
    cover && (
      <div class="padding-global layout12_cover-wrap">
        <div class="container-large">
          <img
            class="layout12_cover"
            src={cover}
            alt=""
            width="1280"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    )
  }
</section>

<style>
  .section_layout12 {
    background-color: var(--color-canvas);
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .layout12_padding {
    padding-top: var(--space-64);
    padding-bottom: var(--space-48);
  }

  .layout12_component {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .layout12_back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    color: var(--color-ink-muted);
    font-size: var(--text-small-size);
    line-height: 1.3;
    font-weight: var(--weight-medium);
  }

  @media (hover: hover) {
    .layout12_back:hover {
      color: var(--color-accent);
    }
  }

  .layout12_meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
    margin-top: var(--space-4);
  }

  .layout12_author {
    display: flex;
    align-items: center;
    gap: var(--space-10, 0.625rem);
  }

  .layout12_author-body {
    display: flex;
    flex-direction: column;
  }

  .layout12_author-name {
    font-size: var(--text-small-size);
    line-height: 1.35;
    font-weight: var(--weight-semibold);
  }

  .layout12_author-role {
    color: var(--color-ink-subtle);
    font-size: var(--text-xsmall-size);
    line-height: 1.35;
  }

  .layout12_facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-ink-subtle);
    font-size: var(--text-small-size);
    line-height: 1.3;
  }

  .layout12_dot {
    width: var(--space-2);
    height: var(--space-2);
    background-color: currentColor;
    border-radius: var(--radius-pill);
  }

  .layout12_cover-wrap {
    padding-bottom: var(--space-48);
  }

  .layout12_cover {
    width: 100%;
    height: 22rem;
    object-fit: cover;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-large);
  }

  @media (max-width: 767px) {
    .layout12_padding {
      padding-top: var(--space-40);
      padding-bottom: var(--space-32);
    }

    .layout12_cover {
      height: 12rem;
    }

    .layout12_cover-wrap {
      padding-bottom: var(--space-32);
    }
  }
</style>
